PUBLIC_HOSTNAME=api.example.com
PUBLIC_BASE_URL=https://api.example.com

POSTGRES_DB=photo_booth
POSTGRES_USER=photo_booth
POSTGRES_PASSWORD=change-me

DEVICE_BEARER_TOKEN=replace-with-long-random-token
DEVICE_ID_PREFIX=booth-
ADMIN_BEARER_TOKEN=replace-with-admin-token
DEFAULT_PROJECT_ID=prj_world_tour

CORS_ORIGIN=*
MAX_UPLOAD_BYTES=104857600

# Local PrintBridge (run from backend/print-bridge)
PORT=18080
DEFAULT_PRINTER_NAME=Noah_Test_Printer
ALLOWED_PRINTER_NAMES=Noah_Test_Printer
OVERRIDE_REQUESTED_PRINTER=true
PRINT_COMMAND=lp
PRINT_OPTIONS=PageSize=w4h6,orientation-requested=3,fit-to-page,MediaMethod=Normal,PaperType=LabelGaps,GapsHeight=3,PostAction=TearOff,Occurrence=Every,Brightness=0,HalftoneType=Stucki,Origin=Default,MirrorImage=False,NegativeImage=False,PrintSpeed=2,Darkness=13
